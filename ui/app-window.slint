import { Button, VerticalBox, TextEdit, HorizontalBox, ScrollView, ListView, LineEdit } from "std-widgets.slint";
// import "./LeagueMono-VF.ttf";

struct LibraryElem{
    name: string,
    nest_level: int,
    is_folder: bool,
    is_hidden: bool,
}

// Display the songs in the library.
component SongLibrary inherits Rectangle{
    in property<[LibraryElem]> song_names: [
        {name: "folder1", nest_level: 0, is_folder: true}, 
        {name: "examplesong1", nest_level: 1, is_folder: false}, 
        {name: "folder2", nest_level: 1, is_folder: true, is_hidden: false}, 
        {name: "examplesong3", nest_level: 2, is_folder: false}, 
        {name: "examplesong4", nest_level: 0, is_folder: false}];
    background: #672b78;
    in property<brush> elem_hover_color: #3a1644;
    in property<brush> button_color: #fbb5fb;

    property<length> offset_per_nest: 20px;
    callback library_elem_clicked(int);
    callback library_add_clicked();
    property<length> lib_width: self.width;

    VerticalBox{
        padding: 0;
        ListView{
            for song[i] in song_names: HorizontalLayout{
                padding: 2px;
                x: offset_per_nest*song.nest_level + 5px;
                alignment: start;
                preferred-height: !song.is_hidden ? 22px : 0px;

                if !song.is_hidden: Rectangle{
                    accessible-role: button;
                    accessible-label: song.name;

                    preferred-width: lib_width - parent.x;
                    background: ta.has-hover ? elem_hover_color : root.background;
                    animate background {duration: 100ms;}
                    ta := TouchArea{
                        preferred-height: 100%;
                        preferred-width: 100%;
                        Text{
                            x: 0;
                            text: song.name;
                            horizontal-alignment: start;
                        }
                        
                        clicked => library_elem_clicked(i);
                    }
                }
            }
        }
        HorizontalBox{
            padding: 2px;
            alignment: end;
            Image{
                source: @image-url("plusbutton.svg");
                colorize: button_color;
                TouchArea{
                    clicked => library_add_clicked();
                }
            }
        }
    }
}

component PlaylistEditListing inherits Rectangle{
    callback song_removed_from_playlist(int);

    in property<[string]> song_list: ["examplesong1", "examplesong2"];
    in property<brush> elem_hover_color: #3a1644;
    in property<brush> button_color: #fbb5fb;

    ListView{
        for song[i] in song_list: Rectangle{
            background: ta.has-hover ? #3a1644 : root.background;
            animate background {duration: 100ms;}
            ta := TouchArea{
                HorizontalBox{
                    // TODO: Drag area
                    Text{
                        text: song;
                    }
                    // remove button (X)
                    Rectangle{}
                    Image{
                        source: @image-url("xbutton.svg");
                        colorize: button_color;
                        TouchArea{
                            clicked => song_removed_from_playlist(i);
                        }
                    }
                }
            }
        }
    }
}

component EditMenu inherits Rectangle{
    callback back_pressed();
    callback song_added_to_playlist(int);
    callback song_removed_from_playlist(int);
    callback save();

    background: bg_color;
    in property<brush> bg_color: #f675f6;
    in property<brush> elem_bg_color: #672b78;
    in property<brush> button_color: #fbb5fb;
    in property<brush> elem_hover_color: #3a1644;

    HorizontalBox{
        alignment: stretch;
        VerticalBox{
            padding: 0;
            width: 50%;
            HorizontalBox{
                padding: 0;
                // Back button
                Image{
                    source: @image-url("backbutton.svg");
                    colorize: button_color;
                    TouchArea{
                        clicked => back_pressed();
                    }
                }
                // Save button
                Image{
                    source: @image-url("skipbutton.svg");
                    colorize: button_color;
                    TouchArea{
                        clicked => save();
                    }
                }
                // Text input
                Rectangle{                    
                    background: elem_bg_color;
                    LineEdit {
                        width: 100%;
                        placeholder-text: "Playlist Name";
                        accepted(text) => {
                            self.clear-focus()
                        }
                    }
                }

            }
            PlaylistEditListing{
                background: elem_bg_color;
            }
        }

        SongLibrary{
            library_elem_clicked(index) => song_added_to_playlist(index); 
        }
    }    
}

// Queue of currently-playing songs.
component SongQueue inherits Rectangle{
    in property<[string]> normal_song_queue: [
         "examplesong1", 
         "examplesong2", 
         "examplesong3",
         "examplesong4",
    ];
    in property<[string]> immediate_queue: [
        "examplesong_a",
        "examplesong_b",
    ];
    in-out property<string> currently_playing: "current_playing";

    in property<brush> queue_background: #672b78;

    callback song_finished() -> string;
    callback notify_song_finished();
    notify_song_finished => {
        currently_playing = song_finished();
    }

    background: #f675f6;
    property<length> offset_per_nest: 10px;

    VerticalBox{
        padding: 0;
        // Currently-playing song.
        Rectangle{
            background: queue_background;
            HorizontalBox{
                alignment: start;
                Text{
                    text: currently_playing;
                    horizontal-alignment: start;
                }
            }
        }

        // User-constructed queue.
        if immediate_queue.length > 0: Rectangle{
            background: queue_background;
            ListView {
                for song[i] in immediate_queue: HorizontalBox{
                    alignment: start;
                    Text{
                        text: song;
                        horizontal-alignment: start;
                    }
                }
            }   
        }

        // Playlist.
        Rectangle{
            background: queue_background;
            ListView {
                for song[i] in normal_song_queue: HorizontalBox{
                    alignment: start;
                    Text{
                        text: song;
                        horizontal-alignment: start;
                    }
                }
            }   
        }
    }
}

component PlayerControls inherits Rectangle{
    property<length> icon_size: 50px;
    min-height: icon_size;
    max-height: icon_size;
    min-width: 2*icon_size;
    max-width: 2*icon_size;
    width: 100%;

    callback pause();
    callback skip();

    property<bool> paused: false;

    // Control buttons.
    HorizontalBox {
        alignment: center;
        Image{
            source: paused ? @image-url("pausebutton.svg") 
                           : @image-url("playbutton.svg");
            colorize: #fbb5fb;
            TouchArea{
                clicked => {
                    paused = !paused;
                    pause()
                };
            }
        }
        Image{
            source: @image-url("skipbutton.svg");
            colorize: #fbb5fb;
            TouchArea{
                clicked => skip();
            }
        }
    }
}

// Component that displays when a playlist is being played currently.
component PlayingMenu inherits Rectangle{
    in property<[string]> playlist_queue: [
         "examplesong1", 
         "examplesong2", 
         "examplesong3",
         "examplesong4",
    ];
    in property<[string]> user_queue: [
        "examplesonga", 
        "examplesongb", 
        "examplesongc",
        "examplesongd",
    ];
    in property<string> currently_playing: "current_playing";
    
    callback skip();
    callback pause();
    callback back_to_menu();

    in property<[LibraryElem]> library;
    callback library_elem_clicked(int);

    // Color properties.
    background: bg_color;
    in property<brush> bg_color: #f675f6;
    in property<brush> elem_bg_color: #672b78;
    in property<brush> elem_color: #f74cf7;
    in property<brush> elem_hover_color: #3a1644;
    in property<brush> button_color: #fbb5fb;

    Image{
        source: @image-url("backbutton.svg");
        colorize: button_color;
        height: 30px;
        x: 5px;
        y: 5px;
        TouchArea{
            clicked => back_to_menu();
        }
    }

    HorizontalBox {
        alignment: stretch;

        VerticalBox {
            padding: 0;
            width: 50%;
            // Album cover.
            Image{
                // source: @image-url("playbutton.svg");
                // image-fit: cover;
                height: 30%;
            }
            // Skip/play/etc.
            PlayerControls {
                skip => skip();
                pause => pause();
            }
            songqueue := SongQueue{
                normal_song_queue: playlist_queue;
                immediate_queue: user_queue;
                currently_playing: currently_playing;   

                queue_background: elem_bg_color;
                background: bg_color;
            }
        }
        
        
        SongLibrary {
            width: 50%;
            song_names: library;
            elem_hover_color: elem_hover_color;
            button_color: button_color;
            library_elem_clicked(index) => library_elem_clicked(index);
        }
    }
}

component PlaylistPlayable inherits Rectangle{
    // width: 90%;
    background: elem_color;
    in property<brush> elem_color: #f74cf7;
    in property<brush> button_color: #fbb5fb;
    in property <string> playlist_name: "example playlist";
    callback play_clicked(string);
    callback edit_clicked(string);

    HorizontalBox{
        padding: 0px;
        // name
        ScrollView{
            content-height: self.height;
            height: name.height;
            content-width: name.width; 
            name := Text{
                font-family: "League Mono";
                height: 70px;
                text: playlist_name;
                horizontal-alignment: left;
                font-size: 36pt;
            }
        }
        // edit button
        ebutton := Image{
            source: @image-url("settings.svg");
            colorize: button_color;
            TouchArea{
                clicked => { edit_clicked(playlist_name); }
            }
        }
        // play button
        pbutton := Image{
            source: @image-url("playbutton.svg");
            colorize: button_color;
            TouchArea{
                clicked => { play_clicked(playlist_name); }
            }
        }
    }
}

component SelectMenu inherits Rectangle{
    background: bg_color;
    in property<brush> elem_bg_color: #672b78;
    in property<brush> elem_color: #f74cf7;
    in property<brush> bg_color: #f675f6;
    in property<brush> button_color: #fbb5fb;
    callback play_clicked(string);
    callback edit_clicked(string);
    callback new_playlist_clicked();
    in property<[string]> playlist_names: ["Example Playlist", "Example Playlist 2.0"];

    Rectangle{
        width: max(50%*root.width, 200px);
        // width: 150px;
        height: 80%;
        background: elem_bg_color;
        VerticalBox {
            padding: 0px;
            ScrollView{
                content-width: self.visible-width;
                VerticalBox{
                    alignment: start;
                    for playlist_name in playlist_names: 
                        PlaylistPlayable{
                            background: elem_color;
                            button_color: button_color;
                            playlist_name: playlist_name;
                            play_clicked(s) => play_clicked(s);
                            edit_clicked(s) => edit_clicked(s);
                    }
                }
            }
            HorizontalBox{
                padding: 0;
                alignment: end;
                Image{
                    source: @image-url("plusbutton.svg");
                    colorize: button_color;
                    TouchArea{
                        clicked => { new_playlist_clicked(); }
                    }
                }
            }
        }
    }
}

enum ScreenState{ select, playing, editing}
export component AppWindow inherits Window {
    // For the PlayingMenu state.
    callback pause();
    callback volume_up();
    callback volume_down();
    callback skip();
    callback song_queued(int);
    callback back_to_menu_from_playing();
    in property <[string]> playlist_queue;
    in property <[string]> user_queue;
    in property <string> currently_playing;
    in property <[LibraryElem]> library;

    // For the PlaylistSelect state.
    callback play_playlist(string);
    callback edit_playlist(string);
    callback add_new_playlist();
    in property <[string]> playlist_names: ["Example Playlist", "Example Playlist 2.0"];

    // For the PlaylistEdit state.
    callback back_to_menu_from_editing();
    callback song_added_to_playlist(int);
    callback song_removed_from_playlist(int);
    callback save();

    // General properties.
    title: "Gelsemium Music Player";
    default-font-family: "League Mono";

    // Color properties.
    property<brush> bg_color: #f675f6;
    property<brush> elem_bg_color: #672b78;
    property<brush> elem_color: #f74cf7;
    property<brush> elem_hover_color: #3a1644;
    property<brush> button_color: #fbb5fb;

    property <ScreenState> state: select;
    if state == ScreenState.select: select_menu := SelectMenu{
        background: bg_color;
        elem_bg_color: elem_bg_color;
        elem_color: elem_color;
        button_color: button_color;

        playlist_names: playlist_names;
        play_clicked(playlist_name) => {
            state = ScreenState.playing;
            play_playlist(playlist_name);
        };
        edit_clicked(playlist_name) => {
            state = ScreenState.editing;
            edit_playlist(playlist_name);
        }
        new_playlist_clicked() => {
            state = ScreenState.editing;
            add_new_playlist();
        }
    }
    if state == ScreenState.playing: playing_menu := PlayingMenu{
        playlist_queue: playlist_queue;
        user_queue: user_queue;
        currently_playing: currently_playing;
        library: library;

        background: bg_color;
        elem_bg_color: elem_bg_color;
        elem_color: elem_color;
        elem_hover_color: elem_hover_color;
        button_color: button_color;

        skip => skip();
        pause => pause();
        library_elem_clicked(index) => song_queued(index);
        back_to_menu => {
            state = ScreenState.select;
            back_to_menu_from_playing();
        }
    }
    if state == ScreenState.editing: edit_menu := EditMenu{
        background: bg_color;
        back_pressed => {
            state = ScreenState.select;
            back_to_menu_from_editing();
        }
    }
}
